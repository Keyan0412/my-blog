---
import "../styles/global.css";
import TableOfContents from "../components/TableOfContents.astro";
import { categories, categoryUrl } from "../lib/categories";

const { title = "Post", headings = [] } = Astro.props;
const category = categories.find((item) => item.slug === Astro.props.frontmatter?.category);
const base = import.meta.env.BASE_URL;

const withBase = (path = "") => {
  const normalizedBase = base.endsWith("/") ? base : `${base}/`;
  const normalizedPath = path.replace(/^\/+/, "");
  return `${normalizedBase}${normalizedPath}`;
};
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body
    class="min-h-screen bg-zinc-900"
    style={`background-image: url('${withBase("images/nanami.jpg")}'); background-size: cover; background-position: center; background-attachment: fixed;`}
  >
    <div class="min-h-screen bg-black/25">
      <div class:list={["post-shell", { "has-outline": headings.length > 0 }]} >
      <TableOfContents headings={headings} />
      <div class="min-w-0 min-h-screen bg-white/80 px-6 py-10 shadow-2xl backdrop-blur-md md:px-10">
        <header class="mb-10 border-b border-zinc-800/10 pb-6">
          <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
            <a href={withBase("")} class="text-3xl font-semibold tracking-wide text-zinc-900">
              可言的博客
            </a>

            <nav class="flex gap-6 text-sm text-zinc-700">
              <a href={withBase("")} class="transition hover:text-black">首页</a>
              <a href={withBase("blog/")} class="transition hover:text-black">博客</a>
            </nav>
          </div>
        </header>

        {category && (
          <nav aria-label="当前位置" class="mb-6 flex flex-wrap gap-2 text-sm text-zinc-600">
            <a href={withBase("blog/")} class="hover:text-black">博客分类</a>
            <span aria-hidden="true">/</span>
            <a href={categoryUrl(category.slug)} class="hover:text-black">{category.title}</a>
          </nav>
        )}

        <article
          class="prose prose-zinc max-w-none
                 prose-headings:font-semibold
                 prose-headings:tracking-tight
                 prose-h1:mb-6 prose-h1:text-4xl
                 prose-h2:mt-12 prose-h2:mb-4 prose-h2:text-2xl
                 prose-h3:mt-8 prose-h3:mb-3 prose-h3:text-xl
                 prose-p:my-5 prose-p:leading-8
                 prose-ul:my-5 prose-ol:my-5
                 prose-li:my-1
                 prose-blockquote:border-zinc-400
                 prose-blockquote:text-zinc-700
                 prose-a:text-blue-700
                 prose-img:rounded-2xl
                 prose-pre:rounded-2xl"
        >
          <slot />
        </article>
      </div>
      </div>
    </div>
  </body>
</html>

<style>
  .post-shell { max-width: 56rem; margin-inline: auto; }
  article :global(h1[id]), article :global(h2[id]), article :global(h3[id]),
  article :global(h4[id]), article :global(h5[id]), article :global(h6[id]) {
    scroll-margin-top: 2rem;
  }
  @media (min-width: 1280px) {
    .post-shell.has-outline {
      display: grid;
      grid-template-columns: clamp(20rem, 28vw, 24rem) minmax(0, 56rem);
      gap: 1.5rem;
      max-width: 84.5rem;
      padding-inline: 1.5rem;
    }
  }
</style>
